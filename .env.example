# ---------------------------------------------------------------------------
# AI Application End-to-End Quality and Performance Testing Platform
# Copy to `.env` (or `backend/.env`) and edit. Every value below has a working
# local default, so the platform runs with no .env file at all.
# Never commit the real .env - it is ignored by .gitignore.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=local
# Where SQLite and uploaded artifacts live (defaults to backend/data)
# DATA_DIR=backend/data
# DATABASE_URL=sqlite:///backend/data/quality.db
# ARTIFACT_DIR=backend/data/artifacts
SEED_ON_STARTUP=true

# --- Auth ------------------------------------------------------------------
# Change this for anything other than a local demo.
SECRET_KEY=local-dev-secret-change-me
TOKEN_TTL_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- Demo AI application under test ---------------------------------------
DEMO_USER_EMAIL=qa@example.com
DEMO_USER_PASSWORD=Passw0rd!

# --- Quality gates (blocking thresholds enforced by CI) -------------------
GATE_API_PASS_RATE=95
GATE_UI_PASS_RATE=90
GATE_API_P95_MS=800
GATE_PAGE_LOAD_MS=3000
GATE_LOAD_ERROR_RATE=1
GATE_DATA_FAILURES=0

# --- Browser (Playwright) runner ------------------------------------------
# Leave false for local dev; CI runs `npx playwright test` and posts the report
# to /api/ingest/playwright instead of driving a browser from the API process.
ENABLE_UI_RUNNER=false
UI_RUNNER_COMMAND=npx playwright test --reporter=json
UI_RUNNER_TIMEOUT_S=600
FRONTEND_URL=http://localhost:5173

# --- Optional AWS integration (fully optional, local fallbacks exist) -----
AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=quality-artifacts
LAMBDA_FUNCTION=
ATHENA_DATABASE=
ATHENA_TABLE=
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT=
CLOUDWATCH_NAMESPACE=AIQualityPlatform

# --- Frontend (Vite) -------------------------------------------------------
# Leave empty to use same-origin requests through the Vite/nginx proxy.
VITE_API_BASE=
